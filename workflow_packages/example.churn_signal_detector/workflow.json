{
  "package_format": "tin-workflow-package-v1",
  "definition": {
    "key": "example.churn_signal_detector",
    "title": "Detect churn signals from customer feedback",
    "description": "Collect support tickets, reviews, and feature requests, extract complaints with a model, cluster and rank them by frequency and severity, then recommend actions to reduce churn.",
    "version": "1.0.0",
    "executor": "workflow.code",
    "schedule_modes": ["on_demand"],
    "human_review": {"eligible": true, "summary": "Review the churn risk report before sharing with the team"},
    "input_schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "project_id": {"type": "string", "format": "uuid"},
        "support_tickets": {
          "type": "array", "minItems": 1, "maxItems": 64,
          "items": {"type": "string", "minLength": 1, "maxLength": 2000},
          "title": "Support tickets or customer complaints"
        },
        "reviews": {
          "type": "array", "minItems": 0, "maxItems": 64,
          "items": {"type": "string", "minLength": 1, "maxLength": 2000},
          "title": "Customer reviews"
        },
        "feature_requests": {
          "type": "array", "minItems": 0, "maxItems": 64,
          "items": {"type": "string", "minLength": 1, "maxLength": 2000},
          "title": "Feature requests"
        }
      },
      "required": ["project_id", "support_tickets"]
    },
    "code": {
      "runtime": "python3.12.8-stdlib-v1",
      "entrypoint": "main.py",
      "files": ["main.py"],
      "timeout_seconds": 60,
      "model_routes": {
        "extract": {
          "provider": "openai", "model": "gpt-5.6-luna", "max_calls": 1,
          "max_input_bytes": 32000, "max_output_tokens": 2048
        },
        "recommend": {
          "provider": "openai", "model": "gpt-5.6-luna", "max_calls": 1,
          "max_input_bytes": 16000, "max_output_tokens": 2048
        }
      },
      "output": {
        "kind": "project.artifact", "path": "reports/CHURN_SIGNALS.md",
        "media_type": "text/markdown", "max_bytes": 16000
      }
    }
  }
}
